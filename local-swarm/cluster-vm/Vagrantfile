Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.synced_folder ".", "/vagrant", type: "virtualbox"
  # Repo root (../../ from cluster-vm) for themes and sources
  config.vm.synced_folder "../..", "/repo", type: "virtualbox"

  config.vm.provider "virtualbox" do |vb|
    vb.cpus = 3
    vb.memory = 4096
  end

  config.vm.define "bastion" do |b|
    b.vm.hostname = "bastion"
    b.vm.network "private_network", ip: "192.168.56.10"
    b.vm.provision "shell", path: "scripts/bootstrap.sh"
  end

  config.vm.define "swarm01" do |m|
    m.vm.hostname = "student-swarm01"
    m.vm.network "private_network", ip: "192.168.56.11"
    m.vm.provision "shell", path: "scripts/bootstrap.sh"
    m.vm.provision "shell", path: "scripts/init-manager.sh"
  end

  config.vm.define "swarm02" do |w|
    w.vm.hostname = "student-swarm02"
    w.vm.network "private_network", ip: "192.168.56.12"
    w.vm.provision "shell", path: "scripts/bootstrap.sh"
    w.vm.provision "shell", path: "scripts/join-worker.sh"
  end

  config.vm.define "swarm03" do |w|
    w.vm.hostname = "student-swarm03"
    w.vm.network "private_network", ip: "192.168.56.13"
    w.vm.provision "shell", path: "scripts/bootstrap.sh"
    w.vm.provision "shell", path: "scripts/join-worker.sh"
  end

  config.vm.define "swarm04" do |w|
    w.vm.hostname = "student-swarm04"
    w.vm.network "private_network", ip: "192.168.56.14"
    w.vm.provision "shell", path: "scripts/bootstrap.sh"
    w.vm.provision "shell", path: "scripts/join-worker.sh"
  end
end
